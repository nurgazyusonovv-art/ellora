# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Серверде гана колдонулат (окуучу аккаунттарын түзүү үчүн). Эч качан браузерге чыгарбаңыз.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI-жардамчы: серверде гана. Ачкычты NEXT_PUBLIC_ менен баштабаңыз.
OPENAI_API_KEY=
OPENAI_TUTOR_MODEL=gpt-4.1-mini

# Мугалимдин сабагын түзүүчү модель.
OPENAI_LESSON_MODEL=gpt-4.1

# Слайд иллюстрациялары: Images API уруксаты жана баланс керек.
OPENAI_SLIDE_IMAGE_MODEL=gpt-image-2.5-flare
